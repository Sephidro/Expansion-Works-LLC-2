{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/qualify", "destination": "/sales#apply", "permanent": true },
    { "source": "/audit-request", "destination": "/sales#apply", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
